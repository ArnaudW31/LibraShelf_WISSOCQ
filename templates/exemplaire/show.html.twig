{% extends 'base.html.twig' %}

{% block title %}Exemplaire{% endblock %}

{% block body %}
    <h1>Exemplaire</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ exemplaire.id }}</td>
            </tr>
            <tr>
                <th>Cote</th>
                <td>{{ exemplaire.cote }}</td>
            </tr>
            <tr>
                <th>Etat</th>
                <td>{{ exemplaire.etat.name }}</td>
            </tr>
            <tr>
                <th>Disponibilite</th>
                <td>{{ exemplaire.disponibilite ? 'Oui' : 'Non' }}</td>
            </tr>
        </tbody>
    </table>

    <button type="button" class="btn btn-outline-primary">
        <a href="{{ path('app_exemplaire_index') }}">Retourner à la liste des exemplaires</a>
    </button>

    <button type="button" class="btn btn-outline-primary">
        <a href="{{ path('app_exemplaire_edit', {'id': exemplaire.id}) }}">Modifier</a>
    </button>

    {{ include('exemplaire/_delete_form.html.twig') }}
{% endblock %}
