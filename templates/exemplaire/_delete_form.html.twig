<form method="post" action="{{ path('app_exemplaire_delete', {'id': exemplaire.id}) }}" onsubmit="return confirm('Êtes vous sur de vouloir supprimer cet exemplaire ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exemplaire.id) }}">
    <button type="button" class="btn btn-outline-danger">SUPPRIMER</button>
</form>
