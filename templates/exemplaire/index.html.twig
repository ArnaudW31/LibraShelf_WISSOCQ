{% extends 'base.html.twig' %}

{% block title %}Gestion exemplaires{% endblock %}

{% block body %}
    <h1>Gérer la liste des exemplaires</h1>
    <button type="button" class="btn btn-outline-primary">
        <a href="{{ path('app_exemplaire_new') }}">Créer un nouvel exemplaire</a>
    </button>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Cote</th>
                <th>Etat</th>
                <th>Disponibilite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for exemplaire in exemplaires %}
            <tr>
                <td>{{ exemplaire.id }}</td>
                <td>{{ exemplaire.cote }}</td>
                <td>{{ exemplaire.etat.name }}</td>
                <td>{{ exemplaire.disponibilite ? 'Oui' : 'Nope' }}</td>
                <td>
                    <a href="{{ path('app_exemplaire_show', {'id': exemplaire.id}) }}">Détails</a>
                    <a href="{{ path('app_exemplaire_edit', {'id': exemplaire.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun exemplaire trouvé flop</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
