{% extends 'base.html.twig' %}

{% block title %}Hello OuvrageController!{% endblock %}

{% block body %}
<h1>Liste des ouvrages</h1>

<h2>Rechercher un ouvrage</h2>

{{ form_start(form, { method: 'get' }) }}
    <div class="row">
        <div class="col">{{ form_row(form.titre) }}</div>
        <div class="col">{{ form_row(form.auteur) }}</div>
        <div class="col">{{ form_row(form.categorie) }}</div>
        <div class="col">{{ form_row(form.tag) }}</div>
        <div class="col">{{ form_row(form.disponible) }}</div>
    </div>
{{ form_end(form) }}

<hr>

<table>
    <thead>
        <tr>
            <th>Titre</th>
            <th>Auteur(s)</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        {% for ouvrage in ouvrages %}
            <tr>
                <td>{{ ouvrage.titre }}</td>

                <td>
                    {% for auteur in ouvrage.auteurs %}
                        {{ auteur.nom }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </td>

                <td>
                    <a href="{{ path('app_reserver_ouvrage', { id: ouvrage.id }) }}"
                       class="btn btn-primary">
                        Réserver
                    </a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
