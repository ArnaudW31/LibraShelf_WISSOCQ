{% extends 'base.html.twig' %}

{% block title %}Liste des ouvrages{% endblock %}

{% block body %}
    <h1>Gérer la liste des ouvrages</h1>
    <button type="button" class="btn btn-outline-primary">
        <a href="{{ path('app_ouvrage_crud_new') }}">Créer un nouvel ouvrage</a>
    </button>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Editeur</th>
                <th>Isbn</th>
                <th>Parution</th>
                <th>Resume</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ouvrage in ouvrages %}
            <tr>
                <td>{{ ouvrage.id }}</td>
                <td>{{ ouvrage.titre }}</td>
                <td>{{ ouvrage.editeur }}</td>
                <td>{{ ouvrage.isbn }}</td>
                <td>{{ ouvrage.parution ? ouvrage.parution|date('Y-m-d') : '' }}</td>
                <td>{{ ouvrage.resume }}</td>
                <td>
                    <a href="{{ path('app_ouvrage_crud_show', {'id': ouvrage.id}) }}">Détails</a>
                    <a href="{{ path('app_ouvrage_crud_edit', {'id': ouvrage.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun ouvrage, créez en !</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
