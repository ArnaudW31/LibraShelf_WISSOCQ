{% extends 'base.html.twig' %}

{% block title %}Ouvrage index{% endblock %}

{% block body %}
    <h1>Ouvrage index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Editeur</th>
                <th>Isbn</th>
                <th>Parution</th>
                <th>Resume</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ouvrage in ouvrages %}
            <tr>
                <td>{{ ouvrage.id }}</td>
                <td>{{ ouvrage.titre }}</td>
                <td>{{ ouvrage.editeur }}</td>
                <td>{{ ouvrage.isbn }}</td>
                <td>{{ ouvrage.parution ? ouvrage.parution|date('Y-m-d') : '' }}</td>
                <td>{{ ouvrage.resume }}</td>
                <td>
                    <a href="{{ path('app_ouvrage_crud_show', {'id': ouvrage.id}) }}">show</a>
                    <a href="{{ path('app_ouvrage_crud_edit', {'id': ouvrage.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ouvrage_crud_new') }}">Create new</a>
{% endblock %}
