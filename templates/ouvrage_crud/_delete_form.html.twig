<form method="post" action="{{ path('app_ouvrage_crud_delete', {'id': ouvrage.id}) }}" onsubmit="return confirm('Êtes-vous sur de vouloir supprimer cet ouvrage ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ouvrage.id) }}">
    <button type="button" class="btn btn-outline-danger">SUPPRIMER</button>
</form>
