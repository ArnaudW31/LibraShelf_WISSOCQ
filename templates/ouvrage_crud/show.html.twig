{% extends 'base.html.twig' %}

{% block title %}Ouvrage{% endblock %}

{% block body %}
    <h1>Ouvrage</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ouvrage.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ ouvrage.titre }}</td>
            </tr>
            <tr>
                <th>Editeur</th>
                <td>{{ ouvrage.editeur }}</td>
            </tr>
            <tr>
                <th>Isbn</th>
                <td>{{ ouvrage.isbn }}</td>
            </tr>
            <tr>
                <th>Parution</th>
                <td>{{ ouvrage.parution ? ouvrage.parution|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Resume</th>
                <td>{{ ouvrage.resume }}</td>
            </tr>
        </tbody>
    </table>

    
    <button type="button" class="btn btn-outline-primary">
        <a href="{{ path('app_ouvrage_crud_index') }}">Retourer sur la liste des ouvrages</a>
    </button>
    <button type="button" class="btn btn-outline-primary">
        <a href="{{ path('app_ouvrage_crud_edit', {'id': ouvrage.id}) }}">Modifier</a>
    </button>
    

    {{ include('ouvrage_crud/_delete_form.html.twig') }}
{% endblock %}
