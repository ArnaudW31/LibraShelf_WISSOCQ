{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Bienvenue à la Bibliothèque</h1>
    <p>Bienvenue sur notre application de gestion de bibliothèque.</p>

    {% if app.user %}
        <p>Connecté en tant que : <strong>{{ app.user.email }}</strong></p>
        <p>Rôle : {{ app.user.roles|join(', ') }}</p>
    {% else %}
        <a class="btn btn-primary" href="{{ path('app_login') }}">Connexion</a>
        <a class="btn btn-secondary" href="{{ path('app_register') }}">Créer un compte</a>
    {% endif %}
</div>
{% endblock %}